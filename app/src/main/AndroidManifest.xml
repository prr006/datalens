<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      DataLens works entirely on-device and has NO internet access.
      The INTERNET permission is deliberately NOT requested.
    -->

    <!-- Special "appop"-style permission: the user must grant Usage Access manually in
         Android Settings (Settings > Apps > Special app access > Usage access).
         It is never granted via the normal runtime permission dialog. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 13+ runtime permission for showing notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11+):
      DataLens uses the smallest practical configuration instead of QUERY_ALL_PACKAGES.
      * The MAIN/LAUNCHER intent query makes every app with a home-screen icon visible,
        which covers virtually every consumer app whose traffic a user cares about.
      * A small list of well-known, non-launchable system components that commonly appear
        in mobile-data statistics is queried explicitly.
      UIDs that cannot be resolved are displayed as "Unknown / System process" rather
      than being mis-attributed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.ims" />
        <package android:name="com.google.android.carrier" />
        <package android:name="com.android.vending" />
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.android.chrome" />
    </queries>

    <application
        android:name=".DataLensApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DataLens"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Used exclusively for sharing an exported report via the standard share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
